{
  "name": "@tieuannguyen/avf",
  "version": "0.2.0",
  "description": "AVF — Automation Validation Framework (evaluate & evolve automation engines against a constant benchmark)",
  "main": "index.mjs",
  "bin": {
    "avf": "./bin/avf.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "bin/",
    "framework/",
    "report/",
    "rules/",
    "oracle/contract.mjs",
    "oracle/review.mjs",
    "oracle/store.mjs",
    "oracle/reviews.json",
    "engines/",
    "benchmark/",
    "knowledge/",
    "connectors/",
    "analytics/model.mjs",
    "analytics/build.mjs",
    "analytics/render.mjs",
    "run-log/model.mjs",
    "run-log/store.mjs",
    "decision/model.mjs",
    "decision/build.mjs",
    "decision/render.mjs",
    "overview/compose.mjs",
    "overview/build.mjs",
    "dashboard/",
    "docs/",
    "examples/",
    "README.md",
    "RELEASE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node kernel-tests/golden.mjs && node connectors/tests/run.mjs",
    "test:kernel": "node kernel-tests/golden.mjs",
    "test:connectors": "node connectors/tests/run.mjs",
    "test:integration": "node connectors/azure-devops/live.test.mjs",
    "test:jira": "node connectors/jira/jira.test.mjs",
    "test:evolution": "node evolution-tests/h4.test.mjs",
    "test:bridge": "node evolution-tests/bridge.test.mjs",
    "test:extract": "node evolution-tests/process-extract.test.mjs",
    "test:policy": "node evolution-tests/policy-modes.test.mjs",
    "test:autoselect": "node evolution-tests/bridge-autoselect.test.mjs",
    "test:h5": "node evolution-tests/h5.test.mjs",
    "test:oracle": "node oracle-tests/oracle.test.mjs",
    "test:report": "node report-tests/report.test.mjs",
    "test:cli": "node cli-tests/run.mjs",
    "test:examples": "node examples-tests/run.mjs",
    "test:analytics": "node analytics/snapshot.test.mjs && node analytics/artifact.test.mjs && node analytics/trend.test.mjs && node analytics/render.test.mjs",
    "test:runlog": "node run-log/run-log.test.mjs",
    "test:decision": "node decision/decision.test.mjs && node decision/artifact.test.mjs && node decision/render.test.mjs",
    "test:overview": "node overview/overview.test.mjs",
    "analytics": "node analytics/build.mjs",
    "decision": "node decision/build.mjs",
    "overview": "node overview/build.mjs",
    "test:dashboard": "node dashboard/render.test.mjs",
    "avf": "node bin/avf.mjs",
    "dashboard": "node dashboard/build.mjs",
    "test:refbridge": "node evolution-tests/referential-bridge.test.mjs",
    "run-h3": "node framework/run.mjs h3 resolution@v0.2",
    "run-h4": "node framework/run.mjs h4 transition@v0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "js-yaml": "^5.2.2"
  }
}
